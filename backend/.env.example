APP_NAME=CareerOps Agent
APP_ENV=local
DATABASE_URL=postgresql+psycopg://careerops:careerops_dev_password@localhost:5433/careerops
LOCAL_STORAGE_DIR=../storage
ENABLE_JOB_DISCOVERY_SCHEDULER=false
DISCOVERY_SCHEDULE_HOUR=8
DISCOVERY_SCHEDULE_MINUTE=0
SCHEDULER_TIMEZONE=America/Bogota
GMAIL_CREDENTIALS_FILE=../storage/secrets/gmail_credentials.json
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_FILE=../storage/secrets/gmail_token.json
GMAIL_TOKEN_JSON=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/gmail/oauth/callback
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_AUTH_ENABLED=false
APP_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PROFILE_MODEL=gpt-5-mini
OPENAI_EMAIL_MODEL=gpt-5-nano
OPENAI_JOB_MODEL=gpt-5-nano
OPENAI_CV_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_AGENT_MAX_INPUT_CHARS=24000
TARGET_ROLE_KEYWORDS=junior software engineer,software engineer,junior software developer,software developer,backend engineer,back-end engineer,backend developer,desarrollador backend,desarrollador de software,programador,full stack engineer,full-stack engineer,fullstack engineer,full stack developer,full-stack developer,fullstack developer,programador full stack,desarrollador full stack,data engineer,junior data engineer,developer de datos,ingeniero de datos,python developer,python engineer
